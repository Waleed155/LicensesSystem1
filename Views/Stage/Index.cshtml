@using Licenses.ViewModels.StageViewModel;
@using Licenses.Dto;
@model PagedResult<StageReadViewModel>

@if (TempData["SavingSuccess"] != null)
{
    <div class="position-fixed top-0 end-0 p-3"
         style="z-index:1100">

        <div id="successToast"
             class="toast align-items-center text-bg-success border-0 shadow-lg rounded-4"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="d-flex">

                <div class="toast-body fs-6">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SavingSuccess"]
                </div>

                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>

            </div>

        </div>

    </div>
}

<link rel="stylesheet"
      href="~/css/Order/Index.css"
      asp-append-version="true" />
<div class="container py-4">
    <div id="Header" 
        class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">
             الخطوات الفرعيه
            </h2>
            <small class="text-muted">
                إدارة جميع الخطوات الفرعيه
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-sm ">
            <i class="bi bi-plus-circle me-1"></i>
            إضافة طلب
        </a>
        <a asp-action="GetAllDeleted" class="btn btn-success btn-sm ">
            <i class="bi bi-recycle"></i>
            صفحه الخطوات الفرعيه المحذوفه
        </a>
    </div>
@if (Model == null)
{
    <div class="alert alert-info shadow-sm text-center">

        <h5 class="mb-2">
                لا توجد خطوات الفرعيه
        </h5>

        <a asp-action="Create" class="btn btn-primary mt-2 btn-sm ">
                إضافة أول خطوه الفرعيه
        </a>

    </div>
}
else
{
        <div class="row g-4">

            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-lg-4 col-md-6">

                    <div class="card h-100 shadow-sm border-0 rounded-4">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>

                                    <h5 class="fw-bold">
                                        @item.Name
                                    </h5>
                                </div>

                                <span class="badge bg-primary">
                                    خطوه فرعيه
                                </span>

                            </div>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <form asp-action="Details" method="post">
                                    <input name="Id" value="@item.Id" type="hidden" />
                                    <input name="Name" value="@item.Name" type="hidden" />
                                    <input name="IsDeleted" value="@item.IsDeleted" type="hidden" />
                                    <button id="BtnDetails"
                                            type="submit"
                                            class="btn btn-info btn-sm">
                                        <i class="bi bi-eye-fill"></i>
                                        تفاصيل
                                    </button>

                                </form>
                                <form asp-action="Edit" method="post" >
                                    <input name="Id" value="@item.Id" type="hidden" />
                                    <input name="Name" value="@item.Name" type="hidden" />
                                    <input name="IsDeleted" value="@item.IsDeleted" type="hidden" />

                                    <button id="BtnEdit" 
                                        type="submit"
                                            class="btn btn-warning btn-sm  ">
                                        <i class="bi bi-pencil-square"></i>
                                        تعديل
                                    </button>
                                    
                                </form>
                                <button class="btn btn-danger btn-sm  "
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        type="button">

                                    <i class="bi bi-trash"></i>
                                    حذف

                                </button>
                            </div>

                        </div>

                    </div>

                </div> 
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav>
                    <ul class="pagination justify-content-center mb-0">

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-search="@ViewBag.Search">
                                        @i
                                    </a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        }

}
</div>

<partial name="DeleteConfirmationModal" />

@section Scripts
{
    <script>
            document.addEventListener("DOMContentLoaded", function () {

            const toastElement = document.getElementById("successToast");

            if (toastElement) {

                const toast = new bootstrap.Toast(toastElement, {
                    delay: 4000
                });

                toast.show();

            }

        });
    </script>
}