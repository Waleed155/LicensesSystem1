@using Licenses.ViewModels
@model ErrorViewModelLicenses
@{
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<script type="module"
        src="https://unpkg.com/@@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs">
</script>

<div class="container min-vh-100 d-flex align-items-center py-5">

    <div class="row justify-content-center w-100">

        <div class="col-xl-10">

            <div class="card border-0 shadow-lg rounded-5 overflow-hidden">

                <div class="row g-0">

                    <!-- Animation -->
                    <div class="col-lg-5 bg-primary-subtle d-flex align-items-center justify-content-center p-4 position-relative">

                        <!-- Rotating Gears -->
                        <div class="gear gear1">⚙️</div>
                        <div class="gear gear2">⚙️</div>

                        <dotlottie-player
                            src="~/lottie/repair.json"
                            background="transparent"
                            speed="1"
                            loop
                            autoplay
                            style="width:100%;max-width:360px;height:360px;">
                        </dotlottie-player>

                    </div>

                    <!-- Text -->
                    <div class="col-lg-7">

                        <div class="card-body p-5">

                            <span class="badge bg-danger mb-3 fs-6">
                                Oops!
                            </span>

                            <h1 class="display-5 fw-bold text-danger mb-3">
                                Something Went Wrong
                            </h1>
                            <p class="lead text-secondary">
                                            @Model.Title           
                                            </p> 
                            <div class="alert alert-warning rounded-4 shadow-sm mt-4">

                                <div class="d-flex">

                                    <div class="display-6 me-3">
                                        ⚠️
                                    </div>

                                    <div>

                                        <h5 class="fw-bold">
                                            Details
                                        </h5>

                                        <p class="mb-0">
                                           @Model.Message
                                       </p>

                                    </div>

                                </div>

                            </div>

                            <div class="mt-5 d-flex flex-wrap gap-3">

                                <button class="btn btn-primary btn-lg px-4"
                                        onclick="location.reload()">

                                    🔄 Try Again

                                </button>

                                <button class="btn btn-outline-secondary btn-lg px-4"
                                        onclick="history.back()">

                                    ← Go Back

                                </button>

                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="btn btn-success btn-lg px-4">

                                    🏠 Home

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

body{
    background:#eef3f9;
}

/* Card */

.card{
    animation:fadeUp .8s ease;
}

/* Floating animation */

dotlottie-player{
    animation:float 3s ease-in-out infinite;
}

@@keyframes float{

0%,100%{
transform:translateY(0);
}

50%{
transform:translateY(-12px);
}

}

/* Rotating gears */

.gear{

    position:absolute;
    font-size:55px;
    animation:spin 8s linear infinite;
    opacity:.25;

}

.gear1{

    top:20px;
    left:25px;

}

.gear2{

    bottom:30px;
    right:30px;
    animation-direction:reverse;
    font-size:70px;

}

@@keyframes spin{

from{
transform:rotate(0deg);
}

to{
transform:rotate(360deg);
}

}

/* Fade */

@@keyframes fadeUp{

from{

opacity:0;
transform:translateY(40px);

}

to{

opacity:1;
transform:translateY(0);

}

}

/* Buttons */

.btn{

transition:.3s;

}

.btn:hover{

transform:translateY(-3px);

}

/* Mobile */

@@media(max-width:991px){

.card-body{

text-align:center;

}

.alert{

text-align:left;

}

.gear{

display:none;

}

}

</style>