@{
}
@model Licenses.ViewModels.ExcutivePositionViewModel.ExcutivePositionAddViewModel

@{
    ViewData["Title"] = "إضافة موقف تنفيذي";
}



<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-xl-5 col-lg-6 col-md-8">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">

                    <h3 class="mb-1">
                        <i class="bi bi-plus-circle-fill"></i>
                        إضافة  موقف تنفيذي
                    </h3>

                    <p class="mb-0 opacity-75">
                        أدخل بيانات الموقف التنفيذي
                    </p>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Name" class="form-label fw-semibold">
                            اسم النشاط</label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder=" اول + ادخل الاسم بهذه الطريقه أرضي" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                <i class="bi bi-check-circle-fill me-2"></i>
                                حفظ

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left-circle me-2"></i>
                                رجوع

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}